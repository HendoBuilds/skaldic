{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Skaldic: core + dialog + scoped fs access to Mordhau SaveGames and Skaldic app data",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    { "identifier": "fs:allow-read-file",  "allow": [{ "path": "$LOCALDATA/Mordhau/Saved/SaveGames/**" }, { "path": "$RESOURCE/**" }, { "path": "$APPDATA/**" }, { "path": "$HOME/**" }] },
    { "identifier": "fs:allow-write-file", "allow": [{ "path": "$LOCALDATA/Mordhau/Saved/SaveGames/**" }, { "path": "$APPDATA/**" }, { "path": "$HOME/**" }] },
    { "identifier": "fs:allow-remove",     "allow": [{ "path": "$LOCALDATA/Mordhau/Saved/SaveGames/**" }, { "path": "$APPDATA/**" }] },
    { "identifier": "fs:allow-exists",     "allow": [{ "path": "$LOCALDATA/Mordhau/Saved/SaveGames" }, { "path": "$LOCALDATA/Mordhau/Saved/SaveGames/**" }, { "path": "$APPDATA" }, { "path": "$APPDATA/**" }] },
    { "identifier": "fs:allow-copy-file",  "allow": [{ "path": "$LOCALDATA/Mordhau/Saved/SaveGames/**" }] },
    { "identifier": "fs:allow-mkdir",      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }] },
    { "identifier": "fs:allow-read-dir",   "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }] }
  ]
}
